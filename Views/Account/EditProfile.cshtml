@model EditProfileViewModel
@{ ViewData["Title"] = "Edit profile"; }
<section class="form-card">
    <h1>Edit profile</h1>
    <form asp-action="EditProfile" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-warn"></div>
        <label class="field"><span>Full name</span><input asp-for="FullName" /><span class="err" asp-validation-for="FullName"></span></label>
        <div class="grid-2">
            <label class="field"><span>Role</span>
                <select asp-for="Role">@foreach (var r in Choices.Roles) { <option value="@r" selected="@(Model.Role == r)">@r</option> }</select>
            </label>
            <label class="field"><span>Time zone</span>
                <select asp-for="TimeZoneLabel">@foreach (var z in Choices.TimeZones) { <option value="@z" selected="@(Model.TimeZoneLabel == z)">@z</option> }</select>
            </label>
        </div>
        <label class="field"><span>Preferred schedule</span>
            <select asp-for="PreferredSchedule">@foreach (var s in Choices.Schedules) { <option value="@s" selected="@(Model.PreferredSchedule == s)">@Choices.Describe(s)</option> }</select>
            <span class="hint">FlexPlan only places flexible tasks inside these hours.</span>
        </label>
        <div class="row"><button class="btn btn-primary">Save changes</button><a class="btn" asp-action="Profile">Cancel</a></div>
    </form>
</section>

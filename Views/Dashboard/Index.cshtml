@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; var returnTo = Context.Request.Path.ToString(); }

<div class="page-head">
    <div>
        <h1>@Model.Greeting, @Model.UserName!</h1>
        <p class="muted">Here’s your plan for today.</p>
    </div>
    <p class="muted strong">@DateTime.Now.ToString("ddd, MMM d, yyyy")</p>
</div>

<div class="stats four">
    <div class="stat"><span class="stat-ic blue"><partial name="_Icon" model='"tasks"' /></span><div><span>Total tasks</span><span class="num">@Model.Total</span></div></div>
    <div class="stat"><span class="stat-ic green"><partial name="_Icon" model='"schedule"' /></span><div><span>Today’s tasks</span><span class="num">@Model.TodayCount</span></div></div>
    <div class="stat"><span class="stat-ic purple"><partial name="_Icon" model='"calendar"' /></span><div><span>Appointments</span><span class="num">@Model.AppointmentsToday</span></div></div>
    <div class="stat @(Model.OverdueCount > 0 ? "bad" : "")"><span class="stat-ic red"><partial name="_Icon" model='"alert"' /></span><div><span>Overdue</span><span class="num">@Model.OverdueCount</span></div></div>
</div>

@if (Model.ConflictCount > 0)
{
    <div class="alert alert-bad">
        <partial name="_Icon" model='"alert"' />
        <div><strong>Scheduling conflict detected.</strong> @Model.ConflictCount item@(Model.ConflictCount == 1 ? " overlaps" : "s overlap") with another.
            <a asp-controller="Schedule" asp-action="Conflicts">See suggested adjustments</a></div>
    </div>
}

<div class="cols">
    <section class="panel">
        <h2>Today’s Schedule</h2>
        @if (Model.Today.Count == 0)
        {
            <p class="empty">Nothing scheduled today. <a asp-controller="Tasks" asp-action="Create">Add a task</a> and FlexPlan will find time for it.</p>
        }
        else
        {
            <ul class="agenda">
                @foreach (var b in Model.Today)
                {
                    <li>
                        <span class="dot @b.CategoryClass"></span>
                        <time>@b.TimeText</time>
                        <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@b.Task.Id">@b.Title</a>
                        <span class="pill @b.CategoryClass">@b.Task.Category</span>
                        <form asp-controller="Tasks" asp-action="SetStatus" method="post">
                            <input type="hidden" name="id" value="@b.Task.Id" /><input type="hidden" name="status" value="Completed" /><input type="hidden" name="returnTo" value="@returnTo" />
                            <button class="btn btn-sm" aria-label="Mark @b.Task.Title as done">Done</button>
                        </form>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="panel">
        <h2>Quick Actions</h2>
        <div class="quick">
            <a class="btn quick-btn" asp-controller="Tasks" asp-action="Create"><partial name="_Icon" model='"plus"' />Add Task</a>
            <a class="btn quick-btn" asp-controller="Tasks" asp-action="Create" asp-route-type="appointment"><partial name="_Icon" model='"calendar"' />Add Appointment</a>
            <a class="btn quick-btn" asp-controller="Calendar" asp-action="Index"><partial name="_Icon" model='"calendar"' />View Calendar</a>
            <form asp-controller="Tasks" asp-action="AutoSchedule" method="post">
                <input type="hidden" name="returnTo" value="@returnTo" />
                <button class="btn quick-btn"><partial name="_Icon" model='"schedule"' />Re-optimize schedule</button>
            </form>
        </div>
        <div class="progress-row"><span>Overall progress</span><strong>@Model.CompletionPercent%</strong></div>
        <div class="bar" role="progressbar" aria-valuenow="@Model.CompletionPercent" aria-valuemin="0" aria-valuemax="100"><i style="width:@Model.CompletionPercent%"></i></div>
    </section>
</div>

<div class="cols">
    <section class="panel">
        <h2>Upcoming deadlines</h2>
        @if (Model.Upcoming.Count == 0) { <p class="empty">No deadlines in the next 7 days.</p> }
        else
        {
            <ul class="plain deadlines">
                @foreach (var t in Model.Upcoming)
                {
                    <li>
                        <div><a asp-controller="Tasks" asp-action="Edit" asp-route-id="@t.Id">@t.Title</a>
                            <div><partial name="_TaskBadges" model="t" /></div></div>
                        <span class="muted small">@t.DueDate.ToString("ddd, MMM d · h:mm tt")</span>
                    </li>
                }
            </ul>
        }
    </section>
    <section class="panel @(Model.Overdue.Count > 0 ? "panel-bad" : "")">
        <h2>Overdue</h2>
        @if (Model.Overdue.Count == 0) { <p class="empty">You’re all caught up.</p> }
        else
        {
            <ul class="plain deadlines">
                @foreach (var t in Model.Overdue.Take(6))
                {
                    <li>
                        <div><a asp-controller="Tasks" asp-action="Edit" asp-route-id="@t.Id">@t.Title</a>
                            <div><partial name="_TaskBadges" model="t" /></div></div>
                        <span class="muted small">was due @t.DueDate.ToString("MMM d, h:mm tt")</span>
                    </li>
                }
            </ul>
        }
    </section>
</div>
